#include "../include/shell.h"

#ifndef BUFFER_SIZE
# define BUFFER_SIZE 42
#endif

static char	*allocate_new_space(char *line, int	old_size, int new_size)
{
	char	*new_line;
	int		i;

	new_line = malloc(new_size);
	if (!new_line)
	{
		free(line);
		return (NULL);
	}
	i = 0;
	while (line[i] && (i < old_size))
	{
		new_line[i] = line[i];
		i++;
	}
	new_line[i] = '\0';
	free(line);
	return (new_line);
}
static int	read_chunk(char *buffer, int *buffer_read, int *buffer_pos)
{
	if (*buffer_pos >= *buffer_read)
	{
		*buffer_read = read(STDIN_FILENO, buffer, BUFFER_SIZE);
		*buffer_pos = 0;
		if (*buffer_read <= 0)
			return (0);
	}
	return (1);
}

static int	check_limiter(char *line, char *limiter)
{
	int	len;

	len = ft_strlen(limiter);
	if(ft_strncmp(line, limiter, len) == 0 && line[len] == '\n')
		return(1); // If limiter is found
	return(0);
}
static void	init_heredoc(char **line, int *line_size)
{
	*line = ft_strdup("");
	*line_size = 0;
	write (STDOUT_FILENO, "> ", 2);
}

char	*read_heredoc_line(char *limiter)
{
	char *line;
	static char buffer[BUFFER_SIZE];
	static int buffer_read;
	static int buffer_pos;
	char *new_line;
	int line_size;


	buffer_read = 0;
	buffer_pos = 0;
	init_heredoc(&line, &line_size);
	while (read_chunk(buffer, &buffer_read, &buffer_pos))
	{
		new_line = allocate_new_space(line, line_size, line_size + 1);
		if (!new_line)
			return (NULL);
		line = new_line; // not sure about this line
		line[line_size++] = buffer[buffer_pos++];
		if (line[line_size - 1] == '\n')
			break ;
	}
	line[line_size] = '\0';
	if (check_limiter(line, limiter))
		return (free(line), NULL);
	return (line);
}
