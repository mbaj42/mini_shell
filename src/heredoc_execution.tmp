#include "../include/shell.h"

char	*execution_heredoc(char *limiter)
{
	char	*line;
	int		len;
	int		fd;

	line = NULL;
	fd = open(".heredoc", O_WRONLY, O_CREAT, O_TRUNC);
	dup2(fd, STDOUT_FILENO);
	while (1)
	{
		line = read_heredoc_line(limiter);
		if (line == NULL)
		{
			free(line);
			return (NULL);
		}
		len = ft_strlen(line);
		write(fd, &line, len);
		len = 0;
		free(line);
	}
	return (0);
}
