#include "../include/shell.h"

char	**put_path_to_string(t_env *envp, t_command_full *arg)
{
	t_env	*tmp;
	char	**path;
	char	**full_path;
	char	*command;
	int		i;

	path = NULL;
	full_path = NULL;
	tmp = envp;
	command = ft_strjoin("/", arg->cmd_name);
	if (find_key(tmp) != NULL)
	{
		path = ft_split(tmp->value, ':');
		i = 0;
		while (path[i++])
		{
			*full_path = ft_strjoin(path[i], command);
			full_path++;
		}
		*full_path = ft_strdup("\0");
		return (full_path);
	}
	return (NULL);
}
int	check_execution(char **path_list, t_command_full *arg, int i)
{
	if (execve(path_list[i], arg->args, NULL) == -1)
	{
		printf("ERROR TU POWINEN BYC\n");
		return (1);
	}
	return (0);
}

int	execute_if_valid(char **path_list, t_command_full *arg, t_env *envp)
{
	int	i;
	int	ret;

	(void)envp;
	i = 0;
	while (path_list[i])
	{
		if (access(path_list[i], X_OK) == 0)
		{
			ret = check_execution(path_list, arg, i);
			ft_free_array(path_list);
			return (ret);
		}
		i++;
	}
	return (1);
}

int	check_path(t_command_full *arg, t_env *envp)
{
	char	**path_list;

	if (ft_strchr(arg->cmd_name, '/'))
	{
		if (access(arg->cmd_name, X_OK) == 0)
			return (check_execution(&arg->cmd_name, arg, 0));
		perror("Error executing command");
		return (1);
	}
	path_list = put_path_to_string(envp, arg);
	if (!path_list)
		return (1);
	if (execute_if_valid(path_list, arg, envp) == 0)
		return (0);
	write(2, "Command not found\n", 18);
	ft_free_array(path_list);
	return (1);
}

void	check_type(t_command_full *arg, t_data **minishell, t_env **envp)
{
	if (is_builtin(arg) == true)
		builtin_commands(minishell, envp);
	else
		check_path(arg, *envp);
}
