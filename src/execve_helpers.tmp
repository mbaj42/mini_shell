#include "../include/shell.h"

char	*find_key(t_env *tmp)
{
	while (tmp)
	{
		if (ft_strncmp(tmp->key, "PATH", 4) == 0)
			return (ft_strdup(tmp->value));
		tmp = tmp->next;
	}
	return (NULL);
}

void	ft_free_array(char **array)
{
	int	i;

	if (!array)
		return ;
	i = 0;
	while (array[i])
	{
		free(array[i]);
		i++;
	}
	free(array);
}
